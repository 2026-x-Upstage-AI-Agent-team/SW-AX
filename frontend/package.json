{
  "name": "swax-intake",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-rhwp.mjs",
    "predev:service": "node scripts/prepare-rhwp.mjs",
    "dev": "vite",
    "dev:service": "vite --mode service",
    "typecheck": "tsc --noEmit",
    "test:review": "node --test tests/review-navigation.mjs",
    "test:ux": "node --test tests/intake-ux.mjs",
    "test:editor": "node --test tests/document-editor.mjs",
    "test:workspaces": "node --test tests/workspaces.mjs",
    "prebuild": "node -e \"require('node:fs/promises').rm('dist', { recursive: true, force: true })\" && node scripts/prepare-rhwp.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@rhwp/editor": "0.9.0",
    "fflate": "0.8.2",
    "lucide-react": "^1.70.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright-core": "1.62.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
